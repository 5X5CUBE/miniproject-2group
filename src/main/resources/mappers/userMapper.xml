<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
	
	<mapper namespace="com.springbootstudy.app.mapper.UserMapper" >
	
	<select id="getUserByNickname" resultType="users">
	    SELECT * 
	    FROM users 
	    WHERE nickname = #{nickname}
	</select>
	
	<select id="getUser" resultType="users">
		SELECT * FROM users WHERE login_id = #{loginId}
	</select>
	
	<insert id="addUser" parameterType="users">
    INSERT INTO users (
        login_id, username,nickname ,password, address,phone,  gender,  birthdate
    )
    VALUES (
        #{loginId}, #{username},#{nickname}, #{password}, #{address},  #{phone},  #{gender}, #{birthdate}
    )
	</insert>
	
	<select id="getUserById" resultType="users">
        SELECT * 
        FROM users 
        WHERE login_id = #{loginId}
    </select>
    
	</mapper>